NODE_ENV=development
PORT=3008
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://transfer_svc:<DB_PASSWORD_TRANSFER>@localhost:5432/transfer_db
JWT_SECRET=
LEDGER_SERVICE_URL=http://localhost:3006
AUTH_SERVICE_URL=http://localhost:3001
# Resuelve las llaves Banklite (envíos con llave).
ACCOUNT_SERVICE_URL=http://localhost:3002
# Clave interna PROPIA de transfer-service (la aceptan auth-service, ledger-service y account-service).
INTERNAL_API_KEY=

# Opcionales (estos son los valores por defecto).
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
